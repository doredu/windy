{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipboard-manager",
  "version": "0.3.2",
  "identifier": "com.windy.clipboard-manager",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "deno task build",
    "beforeBuildCommand": "deno task build"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "Clipboard Manager",
        "url": "popup/index.html",
        "width": 320,
        "height": 340,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Clipboard Manager Settings",
        "url": "settings/index.html",
        "width": 320,
        "height": 220,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "publisher": "dor edu",
    "copyright": "Copyright © 2026 dor edu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/doredu/windy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGQ0ZEMDEzRTU2N0Q2MTkKUldRWjFtZmxFOURQWDI1T09ucUdqWWhnYWN1L0hEVk16UmhKSzdNMTVSK3R5cDArbkpqV0JJOUwK"
    }
  }
}
