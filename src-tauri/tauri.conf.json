{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipboard-manager",
  "version": "0.1.0",
  "identifier": "com.windy.clipboard-manager",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "deno task build",
    "beforeBuildCommand": "deno task build"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "Clipboard Manager",
        "url": "popup/index.html",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
